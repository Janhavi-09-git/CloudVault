# Supabase project settings (required for sign-in and metadata)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# AWS credentials are read only by the Express backend. Prefer an IAM role in production.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-private-cloudvault-bucket

# Optional: CloudFront distribution configured with this S3 bucket as a private OAC origin.
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DOMAIN=

# Generate a random 32-byte key encoded as 64 hex characters (keep this server-only).
ENCRYPTION_KEY=
PORT=4000
MAX_UPLOAD_MB=100
